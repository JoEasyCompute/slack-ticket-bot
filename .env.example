# Bot User OAuth Token (OAuth & Permissions)
SLACK_BOT_TOKEN=xoxb-replace-me
# App-level token with connections:write
SLACK_APP_TOKEN=xapp-replace-me
# One or more channel IDs, separated by commas; invite the bot to each channel.
SLACK_CHANNEL_IDS=C0123456789,C9876543210
# Legacy SLACK_CHANNEL_ID is also supported; SLACK_CHANNEL_IDS takes precedence.
# Emoji name without colons: ticket is 🎫.
TICKET_EMOJI=ticket
# Preserve this folder across restarts to prevent duplicate acknowledgments.
DATA_DIR=./data
