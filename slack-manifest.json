{
  "display_information": {
    "name": "Issue Acknowledger",
    "description": "Manage support tickets with assignment, status and history",
    "background_color": "#243447"
  },
  "features": {
    "bot_user": {
      "display_name": "Issue Acknowledger",
      "always_online": false
    },
    "app_home": {
      "home_tab_enabled": true,
      "messages_tab_enabled": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "reactions:read",
        "chat:write",
        "usergroups:read",
        "channels:read",
        "groups:read",
        "users:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": [
        "reaction_added",
        "app_home_opened",
        "member_joined_channel",
        "member_left_channel"
      ]
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false,
    "interactivity": {
      "is_enabled": true
    }
  }
}
