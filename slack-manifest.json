{
  "display_information": {
    "name": "Issue Acknowledger",
    "description": "Acknowledges issues marked with a ticket reaction",
    "background_color": "#243447"
  },
  "features": {
    "bot_user": { "display_name": "Issue Acknowledger", "always_online": false }
  },
  "oauth_config": {
    "scopes": { "bot": ["reactions:read", "chat:write"] }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["reaction_added"] },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
